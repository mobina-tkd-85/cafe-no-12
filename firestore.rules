rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read the menu (categories + items) — it's a public menu.
    // Only a signed-in admin (created in Firebase Authentication) can write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

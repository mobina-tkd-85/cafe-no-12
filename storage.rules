rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Anyone can view menu/category images. Only a signed-in admin can
    // upload or delete, and only image files under 5MB.
    match /category-logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /menu-items/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
